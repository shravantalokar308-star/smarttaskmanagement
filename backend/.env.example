PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_uri_here
JWT_SECRET=your_jwt_secret_key_here

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
